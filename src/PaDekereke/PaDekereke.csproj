<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Phonology Assistant add-on. PA's undocumented add-on loader
    (App.ReadAddOns, src/Pa/App.cs:367 in sillsdev/phonology-assistant) scans
    <PA install>\AddOns\*.dll at startup and instantiates any public class named
    "PaAddOnManager". Install therefore = copy build output into that folder.

    Must target net48 (matches Pa.exe 4.1.1) and load into a 32-bit process
    (Pa.exe is x86) - AnyCPU DLLs load fine into a 32-bit process, so no
    PlatformTarget is forced here.

    References: the INSTALLED Pa.exe and SilTools.dll, not the PA source tree.
    Override PaInstallDir if PA lives elsewhere:
      dotnet build -p:PaInstallDir="D:\somewhere\PA\"
    On a machine without PA (CI, cloud agents), obtain the two assemblies by
    extracting the PA installer (see HANDOFF.md) and point PaInstallDir at them.

    Offline alternative:
      dotnet build -p:UseStubs=true
    type-checks against the compile-only stubs in src/PaStubs and
    src/SilToolsStubs (built from docs/pa-internals/api-surface.md). The stubs
    must never be shipped or installed, and a green stub build says nothing
    about run-time behaviour against real PA - it only proves the add-on
    compiles against the documented surface.

    Building on Linux/macOS works via Microsoft.NETFramework.ReferenceAssemblies
    (compile only - running still requires Windows).

    net48 defaults to C# 7.3 - keep the code 7.3-compatible.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PaDekereke</RootNamespace>
    <AssemblyName>PaDekereke</AssemblyName>
    <PaInstallDir Condition="'$(PaInstallDir)' == ''">C:\Program Files (x86)\SIL\Phonology Assistant\</PaInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- WinForms for net48 via plain framework references rather than
       UseWindowsForms: the WindowsDesktop MSBuild SDK that property imports
       does not exist in Linux/macOS .NET SDK installs, and for a net48 target
       these references compile identically everywhere. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseStubs)' != 'true'">
    <Reference Include="Pa">
      <HintPath>$(PaInstallDir)Pa.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SilTools">
      <HintPath>$(PaInstallDir)SilTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Compile-only stubs; Private=false keeps the stub Pa.dll/SilTools.dll
       out of the build output so they can never be installed by accident. -->
  <ItemGroup Condition="'$(UseStubs)' == 'true'">
    <ProjectReference Include="..\PaStubs\PaStubs.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\SilToolsStubs\SilToolsStubs.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DekerekeToPa\DekerekeToPa.csproj" />
  </ItemGroup>

</Project>
