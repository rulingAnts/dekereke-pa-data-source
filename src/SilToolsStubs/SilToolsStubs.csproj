<Project Sdk="Microsoft.NET.Sdk">

  <!--
    COMPILE-ONLY STUB. Declares the SilTools.dll surface described in
    docs/pa-internals/api-surface.md so src/PaDekereke can be type-checked on a
    machine with no Phonology Assistant install (dotnet build -p:UseStubs=true).

    The AssemblyName must be exactly "SilTools" so the add-on's reference
    resolves. Every member throws NotImplementedException: this assembly MUST
    NEVER be shipped, installed, or placed anywhere PA could load it. A green
    build against it proves only that the add-on type-checks - nothing about
    run-time behaviour against real PA.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SilTools</AssemblyName>
    <RootNamespace>SilTools</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
